{
  "name": "centro-terapeutico-psyche-backend",
  "version": "1.0.0",
  "description": "Backend del Centro Terapéutico Psyche - Sistema de gestión terapéutica con gamificación",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "nodemon src/servidor.ts",
    "start": "node dist/servidor.js",
    "build": "tsc",
    "postbuild": "copyfiles -u 1 uploads/**/* dist/",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo && npm run db:migrate && npm run db:seed",
    "setup": "npm install && npm run build && npm run db:migrate",
    "setup:dev": "npm install && npm run db:migrate && npm run db:seed",
    "setup:admin": "node scripts/setup-admin.js",
    "crear-admin": "ts-node scripts/crear-admin.ts",
    "crear-psicologos": "ts-node scripts/crear-psicologo.ts",
    "test-psicologos": "ts-node scripts/test-login-psicologo.ts",
    "test:login": "node scripts/test-login.js",
    "test:security": "node scripts/test-security.js",
    "test:email": "node scripts/test-email-bienvenida.js",
    "test:email:config": "node scripts/verificar-configuracion-email.js",
    "test:email:simple": "node scripts/test-email-simple.js",
    "test:crear-psicologo": "node scripts/test-crear-psicologo-con-email.js",
    "debug:email": "node scripts/debug-email-psicologo.js",
    "test:controlador": "node scripts/test-email-controlador.js",
    "verificar:env": "node scripts/verificar-env-servidor.js",
    "db:check": "npx sequelize-cli db:migrate:status",
    "db:create": "npx sequelize-cli db:create",
    "health": "curl http://localhost:3002/salud",
    "kill-ports": "npx kill-port 3002 3004 3006 3008 3010 3011 3012",
    "dev:clean": "npm run kill-ports && npm run dev",
    "logs": "tail -f logs/app.log",
    "docker:build": "docker build -t psyche-backend .",
    "docker:run": "docker run -p 3002:3002 psyche-backend",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down"
  },
  "keywords": [
    "psicologia",
    "terapia",
    "gamificacion",
    "nodejs",
    "typescript",
    "express",
    "postgresql",
    "sequelize"
  ],
  "author": "Equipo Centro Terapéutico Psyche",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/centro-terapeutico-psyche.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/centro-terapeutico-psyche/issues"
  },
  "homepage": "https://github.com/tu-usuario/centro-terapeutico-psyche#readme",
  "dependencies": {
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "axios": "^1.11.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
