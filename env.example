# Configuración del entorno
NODE_ENV=development

# Configuración de la base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=psyche_password
DB_NAME=psyche_db
DB_NAME_TEST=psyche_db_test

# Configuración del servidor
PORT=3001
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# Configuración de Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Configuración de email (SendGrid)
SENDGRID_API_KEY=tu_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@psyche.cl
SENDGRID_FROM_NAME=Centro Terapéutico Psyche

# Configuración de WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Configuración de Gmail API
GMAIL_CLIENT_ID=tu_gmail_client_id
GMAIL_CLIENT_SECRET=tu_gmail_client_secret
GMAIL_REFRESH_TOKEN=tu_gmail_refresh_token

# Configuración de AWS (para producción)
AWS_ACCESS_KEY_ID=tu_aws_access_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=psyche-storage

# Configuración de Sentry (monitoreo)
SENTRY_DSN=tu_sentry_dsn

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000

# Configuración de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Configuración de archivos
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,gif

# Configuración de sesiones
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=30

# Configuración de notificaciones
EMAIL_QUEUE_DELAY_MS=1000
NOTIFICATION_BATCH_SIZE=10

# URLs del frontend (para diferentes subdominios)
FRONTEND_URL_ADMIN=http://admin.localhost:3000
FRONTEND_URL_PSICOLOGO=http://psicologo.localhost:3000
FRONTEND_URL_PACIENTE=http://paciente.localhost:3000

# Configuración del servicio ML
ML_SERVICE_URL=http://localhost:3003
ML_SERVICE_API_KEY=ml_service_api_key_cambiar 