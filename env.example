# ========================================
# CONFIGURACIÓN DEL CENTRO TERAPÉUTICO PSYCHE
# ========================================
# Copia este archivo a .env y configura tus valores

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=psyche_db
DB_USER=postgres
DB_PASSWORD=TU_CONTRASEÑA_PERSONAL_DE_POSTGRESQL

# Base de datos para testing (opcional)
DB_NAME_TEST=psyche_db_test

# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================
PORT=3002
NODE_ENV=development

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================
JWT_SECRET=tu_secreto_super_seguro_aqui

# ========================================
# CONFIGURACIÓN DE EMAIL (opcional)
# ========================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu_email@gmail.com
# EMAIL_PASS=tu_password_de_aplicacion

# ========================================
# CONFIGURACIÓN DE FRONTEND (opcional)
# ========================================
# VITE_API_URL=http://localhost:3002/api/v1

# ========================================
# CONFIGURACIÓN DE LOGS (opcional)
# ========================================
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ========================================
# CONFIGURACIÓN DE CORS (opcional)
# ========================================
# CORS_ORIGIN=http://localhost:3000

# ========================================
# NOTAS IMPORTANTES:
# ========================================
# 1. CAMBIA DB_PASSWORD por tu contraseña personal de PostgreSQL
# 2. CAMBIA JWT_SECRET por un secreto único y seguro
# 3. Este archivo NO se sube al repositorio por seguridad
# 4. Cada desarrollador debe tener su propio archivo .env 