# Configuración del entorno
NODE_ENV=development

# Configuración de la base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Ferreteriakm6
DB_NAME=psyche_db
DB_NAME_TEST=psyche_db_test

# Configuración del servidor
PORT=3001
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# Configuración de Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configuración del servicio ML
ML_SERVICE_URL=http://localhost:3003
ML_SERVICE_API_KEY=tu_api_key_aqui

# Configuración de email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion

# Configuración de subdominios
SUBDOMAIN_PSYCHOLOGIST=psicologo
SUBDOMAIN_PATIENT=paciente
SUBDOMAIN_ADMIN=admin

# Configuración de puertos
BACKEND_PORT=3001
FRONTEND_PORT=3000
ML_SERVICE_PORT=3003
REDIS_PORT=6379

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Configuración de seguridad
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Configuración de sesiones
SESSION_SECRET=tu_session_secret_aqui
SESSION_COOKIE_MAX_AGE=24*60*60*1000

# Configuración de archivos
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Configuración de notificaciones
PUSH_NOTIFICATIONS_ENABLED=true
PUSH_NOTIFICATIONS_KEY=tu_push_key_aqui

# Configuración de gamificación
POINTS_PER_SESSION=10
POINTS_PER_TASK=5
POINTS_PER_ACHIEVEMENT=20
LEVEL_THRESHOLDS=100,250,500,1000,2000

# Configuración de reportes
REPORT_GENERATION_ENABLED=true
REPORT_TEMPLATE_PATH=templates/reports/
REPORT_OUTPUT_PATH=reports/

# Configuración de backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=backups/

# Configuración de monitoreo
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
METRICS_PORT=9090

# Configuración de cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Configuración de websockets
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3002
WEBSOCKET_PATH=/ws

# Configuración de API
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT=100
API_TIMEOUT=30000

# Configuración de base de datos (desarrollo)
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Configuración de logging
LOG_FORMAT=combined
LOG_ROTATION_ENABLED=true
LOG_ROTATION_SIZE=10MB
LOG_ROTATION_FILES=5

# Configuración de testing
TEST_DB_NAME=psyche_db_test
TEST_TIMEOUT=10000
TEST_REPORTER=spec
TEST_COVERAGE_ENABLED=true

# Configuración de desarrollo
HOT_RELOAD_ENABLED=true
DEBUG_ENABLED=true
PROFILING_ENABLED=false

# Configuración de producción
PRODUCTION_DB_HOST=tu_production_db_host
PRODUCTION_DB_PORT=5432
PRODUCTION_DB_NAME=psyche_db_prod
PRODUCTION_DB_USER=tu_production_user
PRODUCTION_DB_PASSWORD=tu_production_password

# Configuración de staging
STAGING_DB_HOST=tu_staging_db_host
STAGING_DB_PORT=5432
STAGING_DB_NAME=psyche_db_staging
STAGING_DB_USER=tu_staging_user
STAGING_DB_PASSWORD=tu_staging_password 