{
  "name": "@psyche/ml-service",
  "version": "1.0.0",
  "description": "Servicio de Machine Learning para análisis de patrones terapéuticos",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "ml:train": "python scripts/train_models.py",
    "ml:predict": "python scripts/predict.py",
    "ml:analyze": "python scripts/analyze_patterns.py"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "lodash": "^4.17.21",
    "@psyche/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "@types/lodash": "^4.14.202",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.2",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "rimraf": "^5.0.5"
  }
} 